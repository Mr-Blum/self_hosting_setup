# ---------------------------------------------------------------------------
# stack.env - single source of truth for the local agentic coding stack.
# Sourced by bootstrap.sh, verify.sh, bundle.sh, restore.sh, model.sh.
# Override any value by exporting it before running a script, e.g.:
#   OLLAMA_CTX=32768 ./bootstrap.sh
# ---------------------------------------------------------------------------

# --- Models ---------------------------------------------------------------
# Both are ~18-19GB at q4_K_M and fit individually in 24GB VRAM.
# They CANNOT be resident simultaneously - see OLLAMA_MAX_LOADED_MODELS.
: "${PRIMARY_MODEL:=qwen3-coder:30b-a3b-q4_K_M}"
: "${SECONDARY_MODEL:=muse-glimmer:30b-q4_K_M}"

# Space-separated list of every model the stack manages.
: "${STACK_MODELS:=${PRIMARY_MODEL} ${SECONDARY_MODEL}}"

# --- Context window -------------------------------------------------------
# OpenCode requires >=64k context (per Ollama's OpenCode integration docs).
# Ollama's own default is only 4096, which silently breaks agentic tool loops.
# 65536 is the floor that keeps OpenCode happy; see README for the VRAM math
# and the fallback ladder if a model spills to CPU.
: "${OLLAMA_CTX:=65536}"

# --- VRAM economy ---------------------------------------------------------
# Flash attention is REQUIRED for KV cache quantization to take effect.
: "${OLLAMA_FLASH_ATTN:=1}"

# q8_0 halves KV cache vs f16 with negligible quality loss. On a 24GB card
# with ~19GB of weights this is what makes 64k context fit at all.
# Ladder if you need more room: q8_0 -> q4_0 (more loss, high-GQA models
# like Qwen are more sensitive). Prefer lowering OLLAMA_CTX over q4_0.
: "${OLLAMA_KV_CACHE:=q8_0}"

# Hard-pin to one resident model. Ollama defaults to 3 per GPU, which on a
# 24GB card would try to co-load two 19GB models and spill to CPU.
: "${OLLAMA_MAX_LOADED:=1}"

# Parallel requests multiply the context allocation (2 parallel @ 64k = 128k
# of KV cache). Must stay at 1 on a single 24GB card.
: "${OLLAMA_PARALLEL:=1}"

# How long an idle model stays in VRAM. Long enough to avoid reload churn
# between prompts, short enough to free the GPU when you walk away.
: "${OLLAMA_KEEPALIVE:=30m}"

# --- Network / privacy ----------------------------------------------------
# Bind loopback only. This stack has NO authentication - do not expose it
# on a network interface without putting an authenticating proxy in front.
: "${OLLAMA_BIND:=127.0.0.1:11434}"

# Disable Ollama's cloud models + web search so nothing leaves the machine.
: "${OLLAMA_DISABLE_CLOUD:=1}"

# --- Versions (pinned for reproducibility) --------------------------------
# Empty OPENCODE_VERSION = resolve latest at bundle/bootstrap time.
# Pin it (e.g. v1.18.32) for byte-identical installs across machines.
: "${OPENCODE_VERSION:=}"
: "${OPENCODE_REPO:=anomalyco/opencode}"
: "${OPENCODE_ASSET:=opencode-linux-x64.tar.gz}"

# --- Paths ----------------------------------------------------------------
: "${OLLAMA_MODELS_DIR:=/usr/share/ollama/.ollama/models}"
: "${OPENCODE_CONFIG_DIR:=${HOME}/.config/opencode}"

# The official install script hardcodes $HOME/.opencode/bin and honours no
# override, so this must match it. It is still used for the offline/restore
# path, where we extract the tarball ourselves and do choose the location.
: "${OPENCODE_INSTALL_DIR:=${HOME}/.opencode/bin}"
